<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup + device-to-device transfer (API 31+). Mirrors
     backup_rules.xml: database and settings only, photos excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="water_it.db" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="water_it.db" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
